# ── Secrets — never commit ────────────────────────────────────────────────────
.env
.env.*
!.env.example
config.yaml
*.key
*.enc

# ── Databases, logs, run artifacts ───────────────────────────────────────────
service_data/
*.db
*.db-wal
*.db-shm
*.log
backtest_runs/
backtest_runs.jsonl
profitable_backtests.jsonl
batch_results.json
auto_universe_cache.json
allocated_balance.json
strategy_specs/archived_runs/
strategy_specs/profitable_runs/
strategy_specs/batch_test*/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
*.egg-info/
.pytest_cache/

# ── Node / Next.js (web has its own .gitignore too) ──────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────────────────────
dist/
build/
*.spec

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/

# Scratch files from research/verification passes — never committed.
scratch_*
